[Unit]
Description=Sidq judge-facing landing page with runnable demos
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/home/dev/sidq
Environment=SIDQ_LANDING_PORT=8766
Environment=DATAHUB_GMS_URL=http://localhost:8080
Environment=DATAHUB_TELEMETRY_ENABLED=false
ExecStart=/home/dev/sidq/.venv/bin/python /home/dev/sidq/web/server.py
Restart=always
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=read-only is load-bearing rather than boilerplate now that the
# page can run commands: both entries in the runnable table are read-only, and
# this is what makes that a property of the sandbox instead of a promise in a
# docstring. A command that tried to write would fail here.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
