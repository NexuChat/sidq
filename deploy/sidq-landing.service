[Unit]
Description=Sidq judge-facing landing page with runnable demos
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=dev
Group=dev
WorkingDirectory=/home/dev/sidq-public
# systemd's default PATH has no ~/.local/bin, where the isolated
# mcp-server-datahub tool lives; the live-audit endpoint spawns it by name.
Environment=PATH=/home/dev/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=SIDQ_LANDING_PORT=8766
Environment=DATAHUB_GMS_URL=http://localhost:8080
Environment=DATAHUB_TELEMETRY_ENABLED=false
ExecStart=/home/dev/sidq-public/.venv/bin/python /home/dev/sidq-public/web/server.py
Restart=always
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=read-only is load-bearing rather than boilerplate now that the
# page can run commands: both entries in the runnable table are read-only, and
# this is what makes that a property of the sandbox instead of a promise in a
# docstring. A command that tried to write would fail here.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# A resource ceiling, not a restart schedule. Every runnable command already has
# a 240s timeout and is killed by process group, so a runaway is bounded before
# systemd needs to act; these bound the *host* if one ever escapes that. The
# ceiling is set well above the observed peak (~210M) because a judge hitting an
# OOM kill mid-audit is a worse failure than the one being defended against.
# Deliberately no RuntimeMaxSec: with Restart=always it would only guarantee the
# page is down for a moment every interval, which buys nothing here.
MemoryMax=1G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
